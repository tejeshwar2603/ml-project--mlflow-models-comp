FROM apache/airflow:2.9.3-python3.11

# No apt-get/build-essential step: every dependency below ships a prebuilt
# manylinux wheel on PyPI, so nothing needs to compile. (Avoids it too - this
# base image's passwd file doesn't resolve "USER root" cleanly.)
COPY requirements.txt /tmp/requirements.txt

# python -m pip, not the `pip` script directly - this base image's pip entry-point
# script is broken (ImportError: cannot import name 'main' from pip._internal.cli.main).
# CPU-only torch wheel to avoid pulling multi-GB CUDA builds inside the container.
RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && python -m pip install --no-cache-dir -r /tmp/requirements.txt \
 && python -m pip install --no-cache-dir kafka-python

ENV PYTHONPATH=/opt/airflow/project
WORKDIR /opt/airflow/project
